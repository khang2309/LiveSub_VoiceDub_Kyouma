# GitHub Linguist Language Detection Overrides
# Exclude vendored web assets, frontend JS/CSS/HTML and data from language statistics
# so GitHub correctly identifies the repository as Pure Rust (>95%)

public/** linguist-vendored
public/** linguist-detectable=false
extension/** linguist-vendored
extension/** linguist-detectable=false
tests/** linguist-vendored
tests/** linguist-detectable=false
data/** linguist-vendored
data/** linguist-detectable=false
models/** linguist-vendored
models/** linguist-detectable=false
scripts/** linguist-vendored
scripts/** linguist-detectable=false
*.js linguist-detectable=false
*.css linguist-detectable=false
*.html linguist-detectable=false
*.bat linguist-detectable=false
*.ps1 linguist-detectable=false
*.vbs linguist-detectable=false
*.json linguist-vendored
*.json linguist-detectable=false
