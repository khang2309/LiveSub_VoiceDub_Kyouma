# GitHub Linguist Overrides - Mark vendored frontend assets, web code, scripts and models
# so GitHub correctly identifies the repository as Pure Rust (100%)

*.js linguist-vendored
*.mjs linguist-vendored
*.css linguist-vendored
*.html linguist-vendored
*.bat linguist-vendored
*.ps1 linguist-vendored
*.vbs linguist-vendored
*.json linguist-vendored
*.toml linguist-vendored

public/* linguist-vendored
public/**/* linguist-vendored
extension/* linguist-vendored
extension/**/* linguist-vendored
scripts/* linguist-vendored
scripts/**/* linguist-vendored
tests/* linguist-vendored
tests/**/* linguist-vendored
data/* linguist-vendored
data/**/* linguist-vendored
models/* linguist-vendored
models/**/* linguist-vendored
src-tauri/* linguist-vendored
src-tauri/**/* linguist-vendored

*.rs linguist-detectable=true
