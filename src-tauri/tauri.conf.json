{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiveSub Studio",
  "version": "1.0.5",
  "identifier": "com.livesub.studio",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LiveSub & VoiceDub AI Studio",
        "url": "loader.html",
        "width": 1380,
        "height": 880,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../public/*.*": "public/",
      "../public/assets/*": "public/assets/",
      "../public/vendor/ort/*": "public/vendor/ort/",
      "../public/vendor/vad/*": "public/vendor/vad/",
      "../models/ocr/*": "models/ocr/",
      "../rust/setup-models.ps1": "rust/setup-models.ps1",
      "../scripts/edge_tts_server.js": "scripts/edge_tts_server.js",
      "../DirectML.dll": "DirectML.dll",
      "../onnxruntime_providers_shared.dll": "onnxruntime_providers_shared.dll",
      "../onnxruntime_providers_cuda.dll": "onnxruntime_providers_cuda.dll",
      "../onnxruntime_providers_tensorrt.dll": "onnxruntime_providers_tensorrt.dll",
      "../onnxruntime_providers_nv_tensorrt_rtx.dll": "onnxruntime_providers_nv_tensorrt_rtx.dll"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
