# LiveSub & VoiceDub AI - Optional Environment Configuration
# Mặc định: VinAI INT8 local cho Anh->Việt và NLLB-200 INT8 local cho đa ngôn ngữ.
# Nếu có Azure Translator, router ưu tiên API cho Hàn/Nhật/Trung và tự lùi về NLLB khi API lỗi.

# --- Azure Translator Cognitive Service (tốc độ thực tế phụ thuộc mạng/khu vực) ---
# AZURE_TRANSLATOR_KEY=your_azure_translator_key_here
# AZURE_TRANSLATOR_REGION=southeastasia

# Mặc định `fastest`: API/Google network trước, model local fallback.
# Đặt `private` nếu muốn dữ liệu chỉ chạy trong máy (local trước).
# TRANSLATION_MODE=fastest
# Optional Gemini quality pass for prefetched subtitle batches only. Gemini is
# too slow for per-sentence realtime translation, so "prefetch" is the default.
# GEMINI_API_KEY=
# GEMINI_TRANSLATION_MODEL=gemini-3.1-flash-lite
# GEMINI_TRANSLATION_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-2.5-flash-lite
# GEMINI_TRANSLATION_MODE=prefetch
# GOOGLE_TRANSLATE_API_KEY=your_google_cloud_translation_key
# DEEPL_API_KEY=your_deepl_api_key

# --- Port cấu hình (mặc định 3000) ---
# PORT=3000
